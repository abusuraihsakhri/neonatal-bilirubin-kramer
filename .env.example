# Neonatal Bilirubin Kramer Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# HMAC-SHA256 audit signing key (minimum 16 characters, recommend 32+)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=replace-with-strong-random-key

# Only the demonstration 'mock' provider is implemented
MODEL_PROVIDER=mock
